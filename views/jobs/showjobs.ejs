<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Jobs - JobNest</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        body {
            background-color: #f5f7fb;
        }
        .job-card {
            transition: all 0.25s ease;
            border-radius: 16px;
        }
        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
        }
        .job-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background-color: #e8f0fe;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            font-size: 22px;
        }
        .job-description {
            color: #64748b;
            min-height: 48px;
        }
        .skill-badge {
            background-color: #eef2ff;
            color: #3730a3;
            font-weight: 500;
        }
    </style>
</head>
<body>
    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #0f172a;">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand fw-bold fs-4" href="/authentication">
                <span style="color: #3b82f6;">JOB</span>NEST
            </a>
            <!-- Mobile button -->
            <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
            >
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Links -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">Post Job</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active px-3" href="#">My Jobs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">Applications</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#"><i class="fa-regular fa-circle-user fs-5"></i></a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>           
    <!-- ================= MY JOBS ================= -->
    <div class="container py-5">
        <!-- Heading -->
        <div class="text-center mb-5">
            <h2 class="fw-bold">Your Posted Jobs</h2>
            <p class="text-muted">Manage the jobs you have posted on JobNest.</p>
        </div>
        <!-- Job Cards -->
        <div class="row g-4">
            <% for(let jobs of job){ %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card job-card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <!-- Top -->
                            <div class="d-flex align-items-center mb-3">
                                <div class="job-icon me-3"><i class="fa-solid fa-briefcase"></i></div>
                                <h5 class="card-title fw-bold mb-1"><%- jobs.title %></h5>
                                <small class="text-muted">Job ID: <%- jobs.job_id %></small>
                            </div>
                        </div>
                        <!-- Description -->
                        <p class="job-description mb-3"><%- jobs.description %></p>
                        <!-- Location -->
                        <div class="mb-2"><i class="fa-solid fa-location-dot text-primary me-2"></i>
                            <span><%- jobs.location %></span>
                        </div>
                        <!-- Salary -->
                        <div class="mb-3">
                            <i class="fa-solid fa-indian-rupee-sign text-primary me-2"></i>
                            <span><%- jobs.salary %></span>
                        </div>
                        <!-- Skills -->
                        <div class="mb-4">
                            <small class="text-muted d-block mb-2">Required Skills</small>
                            <span class="badge skill-badge rounded-pill px-3 py-2"><%- jobs.skills %></span>
                        </div>
                        <!-- Divider -->
                        <hr>
                        <!-- Buttons -->
                        <div class="d-flex gap-2">
                            <!-- Edit -->
                            <form action="/authentication/<%- jobs.job_id %>/edit" method="get" class="flex-grow-1">
                                <button type="submit" class="btn btn-outline-primary w-100"><i class="fa-solid fa-pen me-1"></i>Edit</button>
                            </form>
                            <!-- Delete -->
                            <form action="/authentication/<%- jobs.job_id %>?_method=delete" method="post" class="flex-grow-1">
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    <i class="fa-solid fa-trash me-1"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
