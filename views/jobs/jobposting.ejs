<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post Job - JobNest</title>
    <!-- Bootstrap -->
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"rel="stylesheet">
</head>
<body class="bg-light">
    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #0f172a;">
        <div class="container">Logo
            <a class="navbar-brand fw-bold fs-4" href="/authentication">
                <span style="color: #3b82f6;">JOB</span>NEST
            </a>
            <!-- Mobile button -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Navbar links -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link active px-3" href="/job/<%= id %>">Post Job</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/hrjob/<%= id %>">My Jobs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/hr/applications/<%= id %>">Applications</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#"><i class="fa-regular fa-circle-user fs-5"></i></a>
                    </li>
                </ul>
            </div>
        </div>
    </nav> 
    <!-- ================= POST JOB ================= -->
    <div class="container py-5">
        <!-- Heading -->
        <div class="text-center mb-4">
            <h2 class="fw-bold">Post a Job</h2>
            <p class="text-muted">Create a new opportunity and find the right candidate.</p>
        </div>
        <!-- Form Card -->
        <div class="card border-0 shadow-sm mx-auto" style="max-width: 750px;">
            <div class="card-body p-4 p-md-5">
                <form action="/job/<%= id %>" method="post">
                    <!-- Job Title -->
                    <div class="mb-4">
                        <label for="title" class="form-label fw-semibold">Job Title</label>
                        <input type="text"
                           class="form-control"
                           id="title"
                           name="title"
                           placeholder="e.g. Software Developer"
                           minlength="3"
                           required>
                    </div>
                    <!-- Description -->
                    <div class="mb-4">
                        <label for="description" class="form-label fw-semibold">Job Description</label>
                        <textarea class="form-control"
                            id="description"
                            name="description"
                            rows="5"
                            placeholder="Describe the role, responsibilities and requirements..."
                            minlength="10"
                            required>
                        </textarea>
                    </div>
                    <!-- Required Skills -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Required Skills</label>
                        <div class="border rounded p-3 bg-light">
                            <div class="row">
                                <% skills.forEach(skill => { %>
                                    <div class="col-md-6 mb-2">
                                        <div class="form-check">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="skills"
                                                value="<%= skill.skill_id %>"
                                                id="skill<%= skill.skill_id %>"
                                            >
                                            <label class="form-check-label" for="skill<%= skill.skill_id %>">
                                                <%= skill.skill_name %>
                                            </label>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                        <div class="form-text">Select the skills required for this position.</div>
                    </div>
                    <!-- Location + Salary -->
                    <div class="row">
                        <!-- Location -->
                        <div class="col-md-6 mb-4">
                            <label for="location" class="form-label fw-semibold">Location</label>
                            <input type="text"
                                class="form-control"
                                id="location"
                                name="location"
                                placeholder="e.g. Jaipur"
                                required
                            >
                        </div>
                        <!-- Salary -->
                        <div class="col-md-6 mb-4">
                            <label for="salary" class="form-label fw-semibold">Salary</label>
                            <input type="text"
                                class="form-control"
                                id="salary"
                                name="salary"
                                placeholder="e.g. ₹6-8 LPA"
                                required
                            >
                        </div>
                    </div>
                    <!-- Submit -->
                    <div class="d-grid mt-2">
                        <button type="submit" class="btn btn-primary btn-lg"><i class="fa-solid fa-paper-plane me-2"></i>Post Job</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
