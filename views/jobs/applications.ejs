<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Applications - JobNest</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        body {
            background-color: #f5f7fb;
        }
        /* Application Card */
        .application-card {
            border-radius: 16px;
            transition: all 0.25s ease;
        }
        .application-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
        }
        /* Student Icon */
        .student-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            background-color: #e8f0fe;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            font-size: 22px;
        }
        /* Information */
        .info-label {
            color: #64748b;
            font-size: 14px;
            font-weight: 600;
        }
        /* Buttons */
        .application-btn {
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #0f172a;">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand fw-bold fs-4" href="/authentication">
                <span style="color: #3b82f6;">JOB</span>NEST
            </a>
            <!-- Mobile button -->
            <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Links -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">Post Job</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">My Jobs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active px-3" href="#">Applications</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#"><i class="fa-regular fa-circle-user fs-5"></i></a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- ================= APPLICATIONS ================= -->
    <div class="container py-5">
        <!-- Heading -->
        <div class="text-center mb-5">
            <h2 class="fw-bold">Applications</h2>
            <p class="text-muted">Review candidates who have applied for your jobs.</p>
        </div>
        <!-- Application Cards -->
        <div class="row g-4">
            <% applications.forEach(application => { %>
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card application-card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <!-- Candidate Header -->
                            <div class="d-flex align-items-center mb-4">
                                <div class="student-icon me-3"><i class="fa-solid fa-user-graduate"></i></div>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-1">Candidate</h5>
                                <small class="text-muted">Student ID:<%= application.user_id %></small>
                            </div>
                            <!-- Job -->
                            <div class="mb-3">
                                <div class="info-label mb-1"><i class="fa-solid fa-briefcase me-1"></i>Applied For</div>
                                <div class="fw-semibold"><%= application.title %></div>
                            </div>
                            <!-- Phone -->
                            <div class="mb-3">
                                <div class="info-label mb-1"><i class="fa-solid fa-phone me-1"></i>Phone</div>
                                <div><%= application.phone %></div>
                            </div>
                            <!-- Resume -->
                            <div class="mb-4">
                                <div class="info-label mb-1"><i class="fa-solid fa-file-pdf me-1"></i>Resume</div>
                                <div class="text-truncate"><%= application.resume %></div>
                            </div>
                            <hr>
                            <!-- Accept / Reject -->
                            <div class="d-flex gap-2 mb-2">
                                <form action="/application/<%= application.application_id %>/accept" method="POST" class="flex-grow-1">
                                    <button
                                        type="submit"
                                        class="btn btn-success w-100 application-btn">
                                        <i class="fa-solid fa-check me-1"></i>Accept
                                    </button>
                                </form>
                                <form action="/application/<%= application.application_id %>/reject" method="POST" class="flex-grow-1">
                                    <button
                                        type="submit"
                                        class="btn btn-outline-danger w-100 application-btn">
                                        <i class="fa-solid fa-xmark me-1"></i> Reject
                                    </button>
                                </form>
                            </div>
                            <!-- Analysis -->
                            <form action="/application/<%= application.application_id %>/analysis" method="POST">
                                <button
                                    type="submit"
                                    class="btn btn-outline-primary w-100 application-btn">
                                    <i class="fa-solid fa-chart-simple me-1"></i> Analysis Skills
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
</body>
</html>