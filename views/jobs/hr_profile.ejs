<%- include("../includes/hr_navbar.ejs") %>
    <div class="container py-5">
        <!-- Profile Card -->
        <div class="card border-0 shadow mx-auto" style="max-width: 650px; border-radius: 20px;">
            <div class="card-body p-4 p-md-5">
                <!-- Heading -->
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="fa-solid fa-user-tie" style="font-size: 55px; color: #2563eb;"></i>
                    </div>
                    <h2 class="fw-bold mb-1">HR Profile</h2>
                    <p class="text-muted mb-0">Recruiter Account</p>
                </div>
                <!-- Company -->
                <div class="text-center mb-4">
                    <h4 class="fw-bold mb-1"><%- result.company %></h4>
                    <span class="badge rounded-pill text-bg-primary px-3 py-2">HR / Recruiter</span>
                </div>
                <!-- Information -->
                <div class="border-top pt-4">
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-semibold text-muted">Name</div>
                        <div class="col-sm-8"><%- result.name %></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-semibold text-muted">Email</div>
                        <div class="col-sm-8"><%- result.email %></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 fw-semibold text-muted">Company</div>
                        <div class="col-sm-8"><%- result.company %></div>
                    </div>
                </div>
                <!-- Edit Button -->
                <div class="text-center mt-4">
                    <a href="#" class="btn btn-primary px-4 py-2 rounded-pill"><i class="fa-solid fa-pen-to-square me-2"></i>
                        Edit Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>