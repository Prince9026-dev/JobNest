<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Skill Analysis - JobNest</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>

        body {
            background-color: #f5f7fb;
        }

        .analysis-card {
            border-radius: 18px;
            transition: all 0.25s ease;
        }

        .analysis-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
        }

        .match-box {
            background-color: #eff6ff;
            border-radius: 15px;
            padding: 25px;
        }

        .match-percentage {
            font-size: 42px;
            font-weight: 700;
            color: #2563eb;
        }

        .skill-badge {
            font-size: 14px;
            padding: 8px 12px;
            margin: 4px;
        }

    </style>

</head>


<body>


    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark"
         style="background-color: #0f172a;">

        <div class="container">

            <!-- Logo -->

            <a class="navbar-brand fw-bold fs-4"
               href="/authentication">

                <span style="color: #3b82f6;">JOB</span>NEST

            </a>


            <!-- Mobile button -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>


            <!-- Links -->

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">

                        <a class="nav-link px-3"
                           href="#">
                            Post Job
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3"
                           href="#">
                            My Jobs
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active px-3"
                           href="#">
                            Applications
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3"
                           href="#">

                            <i class="fa-regular fa-circle-user fs-5"></i>

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>



    <!-- ================= SKILL ANALYSIS ================= -->

    <div class="container py-5">


        <!-- Heading -->

        <div class="text-center mb-4">

            <h2 class="fw-bold">
                Application Skill Analysis
            </h2>

            <p class="text-muted">
                Review the candidate's skills against the job requirements.
            </p>

        </div>


        <!-- Main Card -->

        <div class="card analysis-card border-0 shadow-sm mx-auto"
             style="max-width: 750px;">

            <div class="card-body p-4 p-md-5">


                <!-- Application ID -->

                <div class="text-center mb-4">

                    <span class="badge text-bg-secondary rounded-pill px-3 py-2">

                        Application ID:
                        <%= application_id %>

                    </span>

                </div>


                <!-- HR Decision -->

                <div class="mb-4">

                    <h5 class="fw-bold mb-3">

                        <i class="fa-solid fa-gavel me-2 text-primary"></i>

                        HR Decision

                    </h5>


                    <% if (status === "Accepted") { %>

                        <span class="badge bg-success fs-6 px-3 py-2">
                            <i class="fa-solid fa-check me-1"></i>
                            <%= status %>
                        </span>

                    <% } else if (status === "Rejected") { %>

                        <span class="badge bg-danger fs-6 px-3 py-2">
                            <i class="fa-solid fa-xmark me-1"></i>
                            <%= status %>
                        </span>

                    <% } else { %>

                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                            <i class="fa-solid fa-clock me-1"></i>
                            <%= status %>
                        </span>

                    <% } %>

                </div>


                <hr>


                <!-- Skill Match -->

                <div class="match-box text-center my-4">

                    <h5 class="fw-bold mb-2">
                        Skill Match
                    </h5>

                    <div class="match-percentage">
                        <%= matchPercentage %>%
                    </div>

                    <p class="text-muted mb-0">
                        Overall skill match
                    </p>

                </div>


                <hr>


                <!-- Matched Skills -->

                <div class="my-4">

                    <h5 class="fw-bold mb-3">

                        <i class="fa-solid fa-circle-check text-success me-2"></i>

                        Matched Skills

                    </h5>


                    <% if (matchedSkills.length === 0) { %>

                        <div class="alert alert-light border">
                            No matching skills.
                        </div>

                    <% } else { %>

                        <div>

                            <% matchedSkills.forEach(skill => { %>

                                <span class="badge bg-success skill-badge">

                                    <i class="fa-solid fa-check me-1"></i>

                                    <%= skill.skill_name %>

                                </span>

                            <% }) %>

                        </div>

                    <% } %>

                </div>


                <hr>


                <!-- Missing Skills -->

                <div class="my-4">

                    <h5 class="fw-bold mb-3">

                        <i class="fa-solid fa-circle-xmark text-danger me-2"></i>

                        Missing Skills

                    </h5>


                    <% if (missingSkills.length === 0) { %>

                        <div class="alert alert-success">

                            <i class="fa-solid fa-check me-2"></i>

                            No missing skills.

                        </div>

                    <% } else { %>

                        <div>

                            <% missingSkills.forEach(skill => { %>

                                <span class="badge bg-danger skill-badge">

                                    <i class="fa-solid fa-xmark me-1"></i>

                                    <%= skill.skill_name %>

                                </span>

                            <% }) %>

                        </div>

                    <% } %>

                </div>


            </div>

        </div>

    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>