<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Skill</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5">
                <!-- Heading -->
                <div class="text-center mb-4">
                    <div class="mb-3"><i class="fa-solid fa-code fa-3x text-primary"></i></div>
                    <h1 class="fw-bold">Add New Skill</h1>
                    <p class="text-muted">Add a new skill to the JobNest skill list.</p>
                </div>
                <!-- Form Card -->
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <form action="/skills/add" method="post">
                            <!-- Skill Name -->
                            <div class="mb-4">
                                <label for="skill_name" class="form-label fw-semibold">
                                    <i class="fa-solid fa-wand-magic-sparkles text-primary me-2"></i>Skill Name
                                </label>
                                <input
                                    type="text"
                                    name="skill_name"
                                    id="skill_name"
                                    class="form-control form-control-lg"
                                    placeholder="Enter skill name"
                                    required
                                >
                                <div class="form-text">Example: TypeScript, Docker, AWS, Tailwind CSS</div>
                            </div>
                            <!-- Buttons -->
                            <div class="d-flex gap-2">
                                <!-- <a href="/hrjob/<%= hr_id %>" class="btn btn-outline-secondary w-50">
                                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                                </a> -->
                                <button type="submit" class="btn btn-primary w-50" >
                                    <i class="fa-solid fa-plus me-1"></i> Add Skill
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>