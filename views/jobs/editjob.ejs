<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EDIT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8">
                <!-- Page Heading -->
                <div class="text-center mb-4">
                    <h1 class="fw-bold">
                        <i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Job
                    </h1>
                    <p class="text-muted">Update the details of your job posting</p>
                </div>
                <!-- Edit Card -->
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-md-5">
                        <form method="post" action="/job/<%= result.job_id %>?_method=put">
                            <!-- Job Title -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="fa-solid fa-heading text-primary me-2"></i>Job Title
                                </label>
                                <input
                                    type="text"
                                    name="title"
                                    value="<%= result.title %>"
                                    class="form-control form-control-lg"
                                    placeholder="Enter job title"
                                    required
                                >
                            </div>
                            <!-- Description -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="fa-solid fa-align-left text-primary me-2"></i>Job Description
                                </label>
                                <textarea
                                    name="description"
                                    class="form-control"
                                    rows="5"
                                    placeholder="Enter job description"
                                    required
                                ><%= result.description %></textarea>
                            </div>
                            <!-- Skills -->
                            <!-- <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="fa-solid fa-code text-primary me-2"></i>Required Skills
                                </label>
                                <input
                                    type="text"
                                    name="skills"
                                    value="<%= result.skills %>"
                                    class="form-control"
                                    placeholder="Example: JavaScript, Node.js, MySQL"
                                    required
                                >
                                <div class="form-text">Separate multiple skills using commas.</div>
                            </div> -->
                            <!-- Required Skills -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Required Skills</label>
                        <div class="border rounded p-3 bg-light">
                            <div class="row">
                                <% skills.forEach(skill => { %>
                                    <div class="col-md-6 mb-2">
                                        <div class="form-check">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="skills"
                                                value="<%= skill.skill_id %>"
                                                id="skill<%= skill.skill_id %>">
                                                <% if (selectedSkills.includes(skill.skill_id)) { %>
                                                    checked
                                                <% } %>
                                            <label class="form-check-label" for="skill<%= skill.skill_id %>">
                                                <%= skill.skill_name %>
                                            </label>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                            <div class="text-end mt-3">
                                <a href="/skills/add/<%= result.job_id %>" class="btn btn-outline-primary">
                                    <button
                                        type="button"
                                        class="btn btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#addSkillModal"
                                    >
                                        <i class="fa-solid fa-plus me-1"></i>
                                        Add More Skills
                                    </button>
                                </a>
                            </div>
                        <!-- </div>
                        <div class="form-text">Select the skills required for this position.</div>
                    </div> -->
                            <!-- Location -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="fa-solid fa-location-dot text-primary me-2"></i>Location
                                </label>
                                <input
                                    type="text"
                                    name="location"
                                    value="<%= result.location %>"
                                    class="form-control"
                                    placeholder="Enter job location"
                                    required
                                >
                            </div>
                            <!-- Salary -->
                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    <i class="fa-solid fa-indian-rupee-sign text-primary me-2"></i>Salary
                                </label>
                                <input
                                    type="text"
                                    name="salary"
                                    value="<%= result.salary %>"
                                    class="form-control"
                                    placeholder="Example: ₹30,000 - ₹50,000"
                                    required
                                >
                            </div>
                            <!-- Buttons -->
                            <div class="d-flex gap-2 justify-content-end mt-4">
                                <a href="/hrjob/<%= result.hr_id %>" class="btn btn-outline-secondary px-4">
                                    <i class="fa-solid fa-arrow-left me-2"></i>Cancel
                                </a>
                                <button type="submit" class="btn btn-primary px-4">
                                <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
                                </button>        
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>