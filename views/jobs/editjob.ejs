<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Job edit</h1>
    <form method="post" action="/authentication/<%- result.job_id %>?_method=put">
        <input type="text" name="title" value="<%= result.title %>"><br><br>
        <input type="text" value="<%- result.description %>" name="description"><br><br>
        <input type="text" value="<%- result.skills %>" name="skills"><br><br>
        <input type="text" value="<%- result.location %>" name="location"><br><br>
        <input type="text" value="<%- result.salary %>" name="salary"><br><br>
        <button>edit </button>
    </form>
</body>
</html>