<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SKILLS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        .skill-card {
            transition: 0.2s ease;
            cursor: pointer;
        }
        .skill-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
        .form-check {
            min-height: 25px;
        }
        .form-check-input {
            cursor: pointer;
        }
        .form-check-label {
            cursor: pointer;
        }
    </style>

</head>
<body>
    <div class="container py-5">
        <!-- Heading -->
        <div class="text-center mb-5">
            <h1 class="fw-bold"><i class="fa-solid fa-code text-primary"></i>Select Your Skills</h1>
            <p class="text-muted">Select the skills you have to help employers find you.</p>
        </div>
        <form action="/candidate/<%= candidate_id %>/skills" method="post">
            <div class="row g-3">
                <% skills.forEach(skill => { %>
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm skill-card">
                            <div class="card-body">
                                <div class="form-check">
                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        name="skills"
                                        value="<%= skill.skill_id %>"
                                        id="skill<%= skill.skill_id %>"
                                    >
                                    <label class="form-check-label fw-semibold w-100" for="skill<%= skill.skill_id %>">
                                        <%= skill.skill_name %>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
            <!-- Save Button -->
            <div class="text-center mt-5">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="fa-solid fa-floppy-disk me-2"></i>Save Skills
                </button>
            </div>
        </form>
    </div>

</body>
</html>