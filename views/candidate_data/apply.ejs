<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apply Here - JobNest</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        body {
            background-color: #f5f7fb;
        }
        .apply-card {
            border-radius: 18px;
            transition: all 0.25s ease;
        }
        .apply-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
        }
        .apply-icon {
            width: 65px;
            height: 65px;
            border-radius: 15px;
            background-color: #e8f0fe;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            font-size: 27px;
            margin: auto;
        }
        .form-control {
            border-radius: 9px;
        }
        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.15);
        }
    </style>
</head>
<body>
    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #0f172a;">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand fw-bold fs-4" href="/authentication">
                <span style="color: #3b82f6;">JOB</span>NEST
            </a>
            <!-- Mobile button -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Navbar -->
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <!-- Jobs -->
                    <li class="nav-item">
                        <a class="nav-link active px-3" href="/studentjobsearch/<%= result.user_id %>">Jobs</a>
                    </li>
                    <!-- My Applications -->
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">My Applications </a>
                    </li>
                    <!-- Profile -->
                    <li class="nav-item">
                        <a class="nav-link px-3" href="#">
                            <i class="fa-regular fa-circle-user fs-5"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- ================= APPLY HERE ================= -->
    <div class="container py-5">
        <!-- Heading -->
        <div class="text-center mb-4">
            <h2 class="fw-bold">Apply Here</h2>
            <p class="text-muted">Complete your information to apply for this job.</p>
        </div>
        <!-- Card -->
        <div class="card apply-card border-0 shadow-sm mx-auto" style="max-width: 650px;">
            <div class="card-body p-4 p-md-5">
                <!-- Icon -->
                <div class="apply-icon mb-3">
                    <i class="fa-solid fa-file-signature"></i>
                </div>
                <div class="text-center mb-4">
                    <h4 class="fw-bold">Job Application</h4>
                    <span class="badge text-bg-secondary rounded-pill px-3 py-2">Job ID:<%= job_id %></span>
                </div>
                <hr>
                <!-- FORM -->
                 <!-- enctype="multipart/form-data -->
                <form action="/applyed/<%= result.user_id %>/<%= job_id %>" method="post">
                    <!-- Name -->
                    <div class="mb-4">
                        <label for="name" class="form-label fw-semibold">
                            <i class="fa-solid fa-user me-2 text-primary"></i>Full Name
                        </label>
                        <input
                            type="text"
                            class="form-control form-control-lg"
                            id="name"
                            name="name"
                            value="<%- result.name %>"
                            required
                            readonly
                        >
                    </div>
                    <!-- Email -->
                    <div class="mb-4">
                        <label for="email" class="form-label fw-semibold">
                            <i class="fa-solid fa-envelope me-2 text-primary"></i>Email
                        </label>
                        <input
                            type="email"
                            class="form-control form-control-lg"
                            id="email"
                            name="email"
                            value="<%- result.email %>"
                            required
                            readonly
                        >
                    </div>
                    <!-- Phone -->
                    <div class="mb-4">
                        <label for="phone" class="form-label fw-semibold">
                            <i class="fa-solid fa-phone me-2 text-primary"></i>Phone Number
                        </label>
                        <input
                            type="tel"
                            class="form-control form-control-lg"
                            id="phone"
                            name="phone"
                            placeholder="Enter your 10-digit phone number"
                            pattern="[0-9]{10}"
                            maxlength="10"
                            required
                        >
                        <div class="form-text">Enter a valid 10-digit phone number.</div>
                    </div>
                    <!-- Resume -->
                    <div class="mb-4">
                        <label for="resume" class="form-label fw-semibold">
                            <i class="fa-solid fa-file-pdf me-2 text-primary"></i>Upload Resume
                        </label>
                        <input
                            type="file"
                            class="form-control form-control-lg"
                            id="resume"
                            name="resume"
                            accept=".pdf"
                            required
                        >
                        <div class="form-text">Upload your resume in PDF format.</div>
                    </div>
                    <!-- Confirmation -->
                    <div class="form-check mb-4">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="confirm"
                            required
                        >
                        <label class="form-check-label" for="confirm"> I confirm that the information provided is correct.</label>
                    </div>
                    <!-- Next -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">Next
                            <i class="fa-solid fa-arrow-right ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>