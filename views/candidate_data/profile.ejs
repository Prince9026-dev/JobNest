

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Candidate Profile - JobNest</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        body {
            background-color: #f5f7fb;
        }
        .profile-card {
            border-radius: 18px;
            transition: all 0.25s ease;
        }
        .profile-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12) !important;
        }
        .profile-icon {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background-color: #e8f0fe;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            font-size: 40px;
            margin: auto;
        }
        .info-label {
            color: #64748b;
            font-size: 14px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <!-- ================= NAVBAR ================= -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #0f172a;">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand fw-bold fs-4" href="/authentication"> 
                <span style="color: #3b82f6;">JOB</span>NEST
            </a>
            <!-- Mobile button -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <!-- Navbar -->
            <div class="collapse navbar-collapse" id="navbarNav"> 
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <!-- Jobs -->
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/studentjobsearch/<%= result.user_id %>">Jobs</a>
                    </li>
                    <!-- My Applications -->
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/myapplications/<%= result.user_id %>">My Applications</a>
                    </li>
                    <!-- Profile -->
                    <li class="nav-item">
                        <a class="nav-link active px-3" href="#">
                            <i class="fa-regular fa-circle-user fs-5"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- ================= PROFILE ================= -->
    <div class="container py-5">
        <!-- Heading -->
        <div class="text-center mb-4">
            <h2 class="fw-bold">Candidate Profile</h2>
            <p class="text-muted">Manage your JobNest profile.</p>
        </div>
        <!-- Profile Card -->
        <div class="card profile-card border-0 shadow-sm mx-auto" style="max-width: 600px;">
            <div class="card-body p-4 p-md-5">
                <!-- Profile Icon -->
                <div class="profile-icon mb-3">
                    <i class="fa-solid fa-user"></i>
                </div>
                <!-- Name -->
                <div class="text-center mb-4">
                    <h3 class="fw-bold mb-1"> <%- result.name %></h3>
                    <span class="badge text-bg-primary rounded-pill px-3 py-2">Candidate</span>
                </div>
                <hr>
                <!-- Information -->
                <div class="pt-3">
                    <!-- User ID -->
                    <div class="row mb-3">
                        <div class="col-sm-4 info-label">
                            <i class="fa-solid fa-id-card me-2"></i>User ID
                        </div>
                        <div class="col-sm-8"><%- result.user_id %></div>
                    </div>
                    <!-- Name -->
                    <div class="row mb-3">
                        <div class="col-sm-4 info-label">
                            <i class="fa-solid fa-user me-2"></i>Name
                        </div>
                        <div class="col-sm-8"><%- result.name %></div>
                    </div>
                    <!-- Email -->
                    <div class="row mb-3">
                        <div class="col-sm-4 info-label">
                            <i class="fa-solid fa-envelope me-2"></i>Email
                        </div>
                        <div class="col-sm-8"><%- result.email %></div>
                    </div>
                </div>
                <hr>
                <!-- Jobs Button -->
                <div class="d-grid mt-4">
                    <form action="/studentjobsearch/<%= result.user_id %>" method="get">
                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fa-solid fa-magnifying-glass me-2"></i>Find Jobs
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>