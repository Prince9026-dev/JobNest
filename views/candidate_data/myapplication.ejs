<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
    <!-- <h1>My Applications</h1>
    <% if(applications.length === 0){ %>
        <h3>No applications found</h3>
    <% } else{ %>
        <% applications.forEach(application => { %>
            <div>
                <h2><%= application.title %></h2>
                <p>Status: <%= application.status %></p>
                <p>Phone: <%= application.phone %></p>
            </div>
            <hr>
        <% }) %>
    <% } %>  -->
    <div class="container py-5">
        <!-- Page Heading -->
        <div class="text-center mb-5">
            <h1 class="fw-bold">
                <i class="fa-solid fa-file-lines text-primary"></i> My Applications
            </h1>
            <p class="text-muted">Track the jobs you have applied for</p>
        </div>
        <% if(applications.length === 0){ %>
            <!-- No Applications -->
            <div class="card border-0 shadow-sm text-center p-5">
                <div class="mb-3"><i class="fa-solid fa-folder-open fa-4x text-secondary"></i></div>
                <h3 class="fw-bold">No Applications Found</h3>
                <p class="text-muted">You haven't applied for any jobs yet.</p>
                <a href="/jobs" class="btn btn-primary px-4"><i class="fa-solid fa-magnifying-glass"></i>Find Jobs</a>
            </div>
        <% } else { %>
            <div class="row g-4">
                <% applications.forEach(application => { %>
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body p-4">
                                <!-- Job Title -->
                                <h4 class="card-title fw-bold mb-3">
                                    <i class="fa-solid fa-briefcase text-primary me-2"></i><%= application.title %>
                                </h4>
                                <hr>
                                <!-- Status -->
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">Application Status</small>
                                    <% if(application.status === "Accepted"){ %>
                                        <span class="badge bg-success px-3 py-2">
                                            <i class="fa-solid fa-circle-check"></i>Accepted
                                        </span>
                                    <% } else if(application.status === "Rejected"){ %>
                                        <span class="badge bg-danger px-3 py-2">
                                            <i class="fa-solid fa-circle-xmark"></i>Rejected
                                        </span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark px-3 py-2">
                                            <i class="fa-solid fa-clock"></i>Pending
                                        </span>
                                    <% } %>
                                </div>
                                <!-- Phone -->
                                <div class="mb-3">
                                    <small class="text-muted d-block mb-1">Phone</small>
                                    <span><i class="fa-solid fa-phone text-primary me-2"></i><%= application.phone %></span>
                                </div>
                            </div>
                            <!-- Card Footer -->
                            <div class="card-footer bg-white border-0 px-4 pb-4">
                                <span class="text-muted small">
                                    <i class="fa-solid fa-paper-plane"></i>Application submitted
                                </span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</body>
</html> 





