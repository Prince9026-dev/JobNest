<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>JobNest - Find Your Next Opportunity</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <!-- JobNest CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg jobnest-navbar">

        <div class="container-fluid px-lg-5">

            <!-- Logo -->
            <a class="navbar-brand jobnest-logo" href="/authentication">
                <i class="fa-solid fa-briefcase"></i>
                <span>JobNest</span>
            </a>

            <!-- Mobile button -->
            <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#jobnestNavbar">

                <i class="fa-solid fa-bars"></i>

            </button>

            <div class="collapse navbar-collapse" id="jobnestNavbar">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link" href="#explore">
                            Explore
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#companies">
                            Companies
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#candidates">
                            For Candidates
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#employers">
                            For Employers
                        </a>
                    </li>

                    <li class="nav-item ms-lg-4">
                        <a href="/authentication/login"
                            class="signin-btn">
                            Sign in
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- ================= HERO ================= -->

    <section class="hero-section">

        <div class="hero-shape"></div>

        <div class="container hero-container">

            <div class="row align-items-center">

                <!-- LEFT IMAGE / ILLUSTRATION -->

                <div class="col-lg-6 order-2 order-lg-1">

                    <div class="job-illustration">

                        <div class="floating-card card-one">
                            <div class="small-icon">
                                <i class="fa-brands fa-node-js"></i>
                            </div>

                            <div>
                                <strong>Backend Developer</strong>
                                <small>Remote • Full Time</small>
                            </div>
                        </div>


                        <div class="main-job-card">

                            <div class="job-card-top">

                                <div class="company-icon">
                                    <i class="fa-solid fa-building"></i>
                                </div>

                                <div>
                                    <h5>Software Developer</h5>
                                    <p>Technology Company</p>
                                </div>

                            </div>


                            <div class="job-details">

                                <span>
                                    <i class="fa-solid fa-location-dot"></i>
                                    Jaipur / Remote
                                </span>

                                <span>
                                    <i class="fa-solid fa-money-bill-wave"></i>
                                    ₹35,000+
                                </span>

                            </div>


                            <div class="skills">

                                <span>Node.js</span>
                                <span>Express.js</span>
                                <span>MySQL</span>

                            </div>


                            <div class="apply-row">

                                <span>
                                    <i class="fa-solid fa-clock"></i>
                                    New Opportunity
                                </span>

                                <button>
                                    Apply
                                </button>

                            </div>

                        </div>


                        <div class="floating-card card-two">

                            <div class="round-icon">
                                <i class="fa-solid fa-user-check"></i>
                            </div>

                            <div>
                                <strong>Skills Matched</strong>
                                <small>85% Match</small>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- RIGHT CONTENT -->

                <div class="col-lg-6 order-1 order-lg-2">

                    <div class="hero-content">

                        <p class="hero-small-title">
                            <i class="fa-solid fa-sparkles"></i>
                            Your Career Starts Here
                        </p>

                        <h1>
                            Find Your Next
                            <span>Opportunity</span>
                        </h1>

                        <p class="hero-description">
                            JobNest connects talented candidates with
                            companies through skill-based job discovery,
                            applications and career opportunities.
                        </p>


                        <div class="hero-buttons">

                            <a href="/authentication/register"
                                class="create-btn">

                                Create Account
                                <i class="fa-solid fa-arrow-right"></i>

                            </a>

                            <a href="#explore"
                                class="explore-btn">

                                Explore Jobs
                                <i class="fa-solid fa-chevron-down"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- ================= EXPLORE ================= -->

    <section class="explore-section" id="explore">

        <div class="container">

            <div class="section-heading">

                <h2>
                    Explore <span>JobNest</span>
                </h2>

                <p>
                    Everything you need to discover opportunities,
                    connect with companies and manage your applications.
                </p>

            </div>


            <div class="row g-4 mt-4">

                <!-- Candidate -->

                <div class="col-md-4" id="candidates">

                    <div class="feature-card">

                        <div class="feature-icon blue">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>

                        <h4>Discover Jobs</h4>

                        <p>
                            Search and filter jobs according to your
                            skills, interests and preferred location.
                        </p>

                        <a href="/authentication/register">
                            Get Started
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>

                </div>


                <!-- Application -->

                <div class="col-md-4">

                    <div class="feature-card">

                        <div class="feature-icon green">
                            <i class="fa-solid fa-file-circle-check"></i>
                        </div>

                        <h4>Apply Easily</h4>

                        <p>
                            Apply to suitable opportunities and keep
                            track of your application status.
                        </p>

                        <a href="/authentication/register">
                            Start Applying
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>

                </div>


                <!-- HR -->

                <div class="col-md-4" id="employers">

                    <div class="feature-card">

                        <div class="feature-icon orange">
                            <i class="fa-solid fa-building"></i>
                        </div>

                        <h4>Hire Talent</h4>

                        <p>
                            Companies can post jobs and find candidates
                            based on relevant skills.
                        </p>

                        <a href="/authentication/register">
                            Hire Talent
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- ================= COMPANIES ================= -->

    <section class="companies-section" id="companies">

        <div class="container">

            <div class="companies-content">

                <div>
                    <span class="badge-text">
                        FOR COMPANIES
                    </span>

                    <h2>
                        Find the right talent
                        <span>faster.</span>
                    </h2>

                    <p>
                        Post opportunities and discover candidates
                        according to the skills your company needs.
                    </p>
                </div>

                <a href="/authentication/register"
                    class="company-btn">

                    Create Employer Account
                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>

        </div>

    </section>



    <!-- ================= FOOTER ================= -->

    <footer class="jobnest-footer">

        <div class="container">

            <div class="footer-content">

                <div class="footer-logo">

                    <i class="fa-solid fa-briefcase"></i>
                    JobNest

                </div>

                <p>
                    Connecting skills with opportunities.
                </p>

                <span>
                    © 2026 JobNest. All rights reserved.
                </span>

            </div>

        </div>

    </footer>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>